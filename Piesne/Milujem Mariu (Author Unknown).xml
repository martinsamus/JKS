    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pod<chord name="G"/> ochranou<chord name="A"/> Matky sme <chord name="D"/>spoje<chord name="Hmi"/>ní<br/>tým <chord name="G"/>putom, ktoré <chord name="A"/>nik ned<chord name="D"/>elí.<br/><chord name="G"/>Cítime <chord name="A"/>silu Bo<chord name="Hmi"/>žej lásky,<br/>v<chord name="G"/> ktorej je Duch dobro<chord name="A4"/>ty.<chord name="A"/></lines>
    </verse>
    <verse name="v2">
      <lines><chord name="G"/> Obráť sa k<chord name="A"/> Márii, <chord name="D"/>modli sa s<chord name="Hmi"/> ňou,<br/>ona<chord name="G"/> je tou <chord name="A"/>bránou,<chord name="D"/><br/><chord name="G"/>cez ňu ti<chord name="A"/> otvára<chord name="Hmi"/> náručie Boh,<br/><chord name="G"/> neváhaj, priblíž sa k<chord name="A4"/> nej<chord name="A"/>.</lines>
    </verse>
    <verse name="c1">
      <lines><chord name="D"/> Milujem Máriu, <chord name="G"/>mám<chord name="A"/> ju<chord name="D"/> rád,<br/>som <chord name="G"/>dieťa, ktoré<chord name="A"/> Matku<chord name="D"/> má.<br/><chord name="D"/>Kráľovnej vesmíru s<chord name="G"/>pi<chord name="A"/>evam <chord name="D"/>dnes,<br/>tej, <chord name="G"/>ktorá srdce<chord name="A"/> otvá<chord name="D"/>ra.</lines>
    </verse>
  </lyrics>
