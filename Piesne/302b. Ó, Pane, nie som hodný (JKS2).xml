  <properties>
    <titles>
      <title>302b. Ó, Pane, nie som hodný</title>
    </titles>
    <authors>
      <author>JKS2</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Ó, Pane, nie som hodný,<br/>abys' zostúpil do srdca môjho,<br/>len slovom povedz,<br/>len slovom povedz,<br/>a uzdravená bude duša moja<br/>a uzdravená bude duša moja.</lines>
    </verse>
  </lyrics>
