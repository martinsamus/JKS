<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:40">
  <properties>
    <titles>
      <title>288. Tebe žijem, Ježiš môj</title>
    </titles>
    <authors>
      <author>Eucharistické</author>
      <author>JKS</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>1.                                             288.<br/>Tebe žijem, Ježiš môj,<br/>tebe Ježiš, umieram,<br/>v živote aj vo smrti<br/>tebe patriť si žiadam.</lines>
    </verse>
    <verse name="v2">
      <lines>2.                                             288.<br/>Moje srdce úbohé<br/>prijmi, Bože, láskave,<br/>naveky chcem tvojím byť<br/>a žiť tvojej oslave.</lines>
    </verse>
  </lyrics>
</song>
