  <lyrics>
    <verse name="v1">
      <lines>Velebte Pána, všetky národy.</lines>
    </verse>
    <verse name="v2">
      <lines>Bože, nech ťa velebia národy, nech ťa velebia všetky národy.</lines>
    </verse>
    <verse name="v3">
      <lines>Bože, buď nám milostivý <br/>a žehnaj nás</lines>
    </verse>
  </lyrics>
