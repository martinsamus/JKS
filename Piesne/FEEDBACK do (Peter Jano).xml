<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:42">
  <properties>
    <titles>
      <title>FEEDBACK do</title>
    </titles>
    <authors>
      <author>Peter Jano</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>1. Čo sa ti najviac páčilo?</lines>
    </verse>
    <verse name="v2">
      <lines>2. Čo sa ti najmenej páčilo?</lines>
    </verse>
    <verse name="v3">
      <lines>3. Čo by si zmenil (vynechal alebo pridal)?</lines>
    </verse>
    <verse name="v4">
      <lines>4. Čo si so sebou odnášate?</lines>
    </verse>
    <verse name="v5">
      <lines>5.  Zučastili by ste sa ešte v budúcnosti duchovnej obnovy?</lines>
    </verse>
  </lyrics>
</song>
