<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:44">
  <properties>
    <titles>
      <title>Môj Pán mojou silou je</title>
    </titles>
    <authors>
      <author>Anonymous</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Môj Pán mojou silou je a radostnou piesňou.<br/>A Pán stál sa už mojím spasením, on je môj Boh.</lines>
    </verse>
    <verse name="c1">
      <lines>Len jemu odovzdávam život svoj.     4x<br/></lines>
    </verse>
  </lyrics>
</song>
