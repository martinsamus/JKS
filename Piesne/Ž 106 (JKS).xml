  <properties>
    <titles>
      <title>Ž 106</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Odpusť, Pane, <br/>vinu svojmu ľudu.</lines>
    </verse>
    <verse name="v2">
      <lines>Oslavujte Pána, lebo je dobrý.</lines>
    </verse>
    <verse name="v3">
      <lines>Pamätaj na nás, Pane, <br/>z lásky k svojmu ľudu.</lines>
    </verse>
  </lyrics>
</song>
