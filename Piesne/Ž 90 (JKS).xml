<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 90</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pane, stal si sa nám útočiskom<br/>z pokolenia na pokolenie.</lines>
    </verse>
    <verse name="v2">
      <lines>Naplň nás, Pane, svojou milosťou <br/>a budeme jasať.</lines>
    </verse>
    <verse name="v3">
      <lines>Obdaruj nás, Pane, múdrosťou srdca.</lines>
    </verse>
    <verse name="v4">
      <lines>Požehnaj, Pane,<br/>námahu našich rúk.</lines>
    </verse>
  </lyrics>
</song>
