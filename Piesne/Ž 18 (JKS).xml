  <lyrics>
    <verse name="v1">
      <lines>Milujem ťa, Pane, <br/>ty moja sila.</lines>
    </verse>
    <verse name="v2">
      <lines>V úzkosti som ťa vzýval, Pane, zachráň ma.</lines>
    </verse>
    <verse name="v3">
      <lines>Velebím ťa, Bože, ty moja spása.</lines>
    </verse>
  </lyrics>
