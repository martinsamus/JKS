      <title>Pristup blizsie</title>
    </titles>
    <verseOrder>v1 c1 v2 c1</verseOrder>
    <authors>
      <author>Author Unknown</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines><chord name="G"/> Pristúp bližšie,<chord name="C"/> nebuď sám,<chord name="G"/> vytvoríme ni<chord name="D"/>ečo krásne.<br/><chord name="G "/> Každý <chord name="C "/>z nás <chord name="G "/>je Boží c<chord name="D"/>hrám, v k<chord name="D7"/>aždom z nás je niečo zvláštne!</lines>
    </verse>
    <verse name="v2">
      <lines><chord name="G"/> Vlož[ ] do <chord name="C "/>dlane<chord name="G "/> svoju dl<chord name="D"/>aň, zjednoťme sa v Jeho mene.<br/><chord name="G "/> Boh zostúp<chord name="C G "/>il z neba k<chord name="D"/> nám. Jeho L<chord name="D7"/>áska v každom drieme.</lines>
    </verse>
    <verse name="c1">
      <lines><chord name="G "/> Boh <chord name="D"/>nás v ruk<chord name="G C "/>ách má, pr<chord name="D"/>eto spievame a hráme.<br/><chord name="G"/> N[ ]es<chord name="D"/>ie teba<chord name="G"/> a mňa, ve<chord name="C"/>ľkú rado[ ]sť z t<chord name="D"/>oho mám<chord name="D7"/>e</lines>
    </verse>
  </lyrics>
