  <properties>
    <titles>
      <title>Nas Pan_On je kralov Kral</title>
    </titles>
    <authors>
      <author>detsky zbor</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Náš Pán, On je kráľov Kráľ, jeho trón<br/>bude naveky stáť. On má<br/>všetku vládu a moc, náš Pán.<br/>On je kráľov Kráľ.</lines>
    </verse>
  </lyrics>
