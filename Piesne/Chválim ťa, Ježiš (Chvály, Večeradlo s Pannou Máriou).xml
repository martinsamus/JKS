  <properties>
    <titles>
      <title>Chválim ťa, Ježiš</title>
    </titles>
    <authors>
      <author>Večeradlo s Pannou Máriou</author>
      <author>Chvály</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="c1">
      <lines>[: Chválim ťa Ježiš :] – 4x</lines>
    </verse>
    <verse name="v1">
      <lines>[:Ani oko nevidelo, <br/>ani ucho nepočulo<br/>čo má Boh pripravené pre nás:]</lines>
    </verse>
    <verse name="v2">
      <lines>Pre tých, ktorí milujú, <br/>pre tých, ktorí vzývajú meno Pána,<br/>pre tých, ktorí uveria,<br/>pre tých, ktorí chvália tvoje meno Pane.</lines>
    </verse>
  </lyrics>
