  <lyrics>
    <verse name="v1">
      <lines>Iba v Bohu spočiň, duša moja.</lines>
    </verse>
    <verse name="v2">
      <lines>Ty, Pane, každému odplácaš podľa jeho skutkov.</lines>
    </verse>
    <verse name="v3">
      <lines>V Bohu je moja spása <br/>i moja sláva.</lines>
    </verse>
  </lyrics>
