<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:46">
  <properties>
    <titles>
      <title>Svätá Mária, Matka Božia</title>
    </titles>
    <authors>
      <author>Mariánska</author>
      <author>Pôstna</author>
      <author>Taize</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Svätá Mária, Matka Božia,<br/>ó Mária, pros za nás hriešnikov.<br/>Pros za nás, ó Mária, milosti plná,<br/>svätá Mária. Mária.</lines>
    </verse>
  </lyrics>
</song>
