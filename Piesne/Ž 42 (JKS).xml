  <lyrics>
    <verse name="v1">
      <lines>Ako jeleň dychtí za vodou <br/>z prameňa,<br/>tak moja duša, Bože,<br/>túži za tebou.</lines>
    </verse>
    <verse name="v2">
      <lines>Po Bohu žízni moja duša, <br/>po Bohu živom.</lines>
    </verse>
    <verse name="v3">
      <lines>Po Bohu žízni moja duša.</lines>
    </verse>
  </lyrics>
</song>
