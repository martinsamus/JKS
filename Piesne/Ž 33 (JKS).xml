<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:48">
  <properties>
    <titles>
      <title>Ž 33</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Tvoje milosrdenstvo, Pane, <br/>nech je nad nami,<br/>ako dúfame v teba.</lines>
    </verse>
    <verse name="v2">
      <lines>Blažený ľud, <br/>ktorý patrí Pánovi.</lines>
    </verse>
    <verse name="v3">
      <lines>Blažený ľud,<br/>ktorý si Pán vyvolil<br/>za dedičstvo.</lines>
    </verse>
    <verse name="v4">
      <lines>Milosti Pánovej <br/>plná je zem.</lines>
    </verse>
    <verse name="v5">
      <lines>Pánovým slovom povstali nebesia.</lines>
    </verse>
    <verse name="v6">
      <lines>Plesajte, spravodliví, <br/>v Pánovi, spievajte mu novú pieseň.</lines>
    </verse>
  </lyrics>
</song>
