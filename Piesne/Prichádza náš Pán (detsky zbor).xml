  <properties>
    <titles>
      <title>Prichádza náš Pán</title>
    </titles>
    <authors>
      <author>detsky zbor</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pricházda náš Pán, prichádza náš Kráľ. <br/>Prichádza medzi nás Ježiš.<br/>Majstrer náš, priateľ náš.<br/>Prichádza medzi nás Ježiš.</lines>
    </verse>
  </lyrics>
