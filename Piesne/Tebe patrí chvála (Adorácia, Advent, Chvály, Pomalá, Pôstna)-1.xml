  <properties>
    <titles>
      <title>Tebe patrí chvála</title>
    </titles>
    <authors>
      <author>Pomalá</author>
      <author>Chvály</author>
      <author>Adorácia</author>
      <author>Advent</author>
      <author>Pôstna</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>|: Tebe patrí chvála a sláva<br/>pozdvihnime svoje ruky<br/>a chváľme sväté meno. :|<br/><br/>|: Lebo Ty si Pán,<br/>veľké veci robíš nám.<br/>Nikto nie je ako Ty,<br/>nikto nie je ako Ty. :|</lines>
    </verse>
  </lyrics>
