  <properties>
    <titles>
      <title>Ž 139</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Chválim ťa, Pane, <br/>že som vznikol tak zázračne.</lines>
    </verse>
    <verse name="v2">
      <lines>Pane, ty ma skúmaš a vieš o mne všetko.</lines>
    </verse>
    <verse name="v3">
      <lines>Veď ma, Pane, <br/>po ceste k večnosti</lines>
    </verse>
  </lyrics>
</song>
