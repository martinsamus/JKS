<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:48">
  <properties>
    <titles>
      <title>Ž 9</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Aké vznešené je tvoje meno, Pane, Bože náš.</lines>
    </verse>
    <verse name="v2">
      <lines>Pán bude spravodlivo súdiť celý svet.</lines>
    </verse>
    <verse name="v3">
      <lines>Pán, Boh, súdi spravodlivo národy.</lines>
    </verse>
    <verse name="v4">
      <lines>Pane, ty neopúšťaš tých, čo ťa hľadajú.</lines>
    </verse>
  </lyrics>
</song>
