<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:45">
  <properties>
    <titles>
      <title>Otváraj</title>
    </titles>
    <authors>
      <author>Pomalá</author>
      <author>Pôstna</author>
      <author>Advent</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Otváraj Pánovi nášmu,<br/>otváraj, prichádza k nám,<br/>otváraj bratom a sestrám dokorán.<br/>Orváraj Duchu Svätému,<br/>otváraj, prichádza k nám,<br/>otváraj Božiimu Slovu dokorán.</lines>
    </verse>
    <verse name="v2">
      <lines>Effatha, effatha.<br/>Effatha, effatha.</lines>
    </verse>
  </lyrics>
</song>
