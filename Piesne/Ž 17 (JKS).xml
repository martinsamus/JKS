      <title>Ž 17</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Až raz vstanem zo sna, uzriem tvoju tvár, Pane.</lines>
    </verse>
    <verse name="v2">
      <lines>Ja v spravodlivosti <br/>uzriem tvoju tvár, Pane.</lines>
    </verse>
    <verse name="v3">
      <lines>Nakloň ku mne svoj sluch <br/>a vypočuj moje slová.</lines>
    </verse>
  </lyrics>
</song>
