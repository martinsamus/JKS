<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2025-03-29T14:06:43">
  <properties>
    <titles>
      <title>Prosím ťa, odpusť mi</title>
    </titles>
    <authors>
      <author>Anonymous</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Prosím Ťa, odpusť mi, že život môj Ťa bolí.<br/>Prosím Ťa, odpusť mi, že otváram Ti rany.<br/>Prosím Ťa, odpusť mi, môj Pane utýraný.</lines>
    </verse>
  </lyrics>
</song>
