<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:43">
  <properties>
    <titles>
      <title>Je stále prítomná</title>
    </titles>
    <authors>
      <author>Advent</author>
      <author>Začiatok</author>
      <author>Pôstna</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Je stále prítomná,<br/>Tvoja láska<br/>radostne spievame<br/>o Tvojej sláve.<br/>Nech pieseň zazvoní<br/>v každej chvíli,<br/>Teba chválim Pane môj,<br/>ako najlepšie viem.</lines>
    </verse>
  </lyrics>
</song>
