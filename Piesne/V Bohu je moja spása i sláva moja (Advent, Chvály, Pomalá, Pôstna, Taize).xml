  <properties>
    <titles>
      <title>V Bohu je moja spása i sláva moja</title>
    </titles>
    <authors>
      <author>Advent</author>
      <author>Pôstna</author>
      <author>Chvály</author>
      <author>Pomalá</author>
      <author>Taize</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>V Bohu je moja spása i sláva moja,<br/>len Boh je moja sila.<br/>len v Bohu nájde pokoj duša moja.<br/>v ňom je nádej moja.</lines>
    </verse>
  </lyrics>
