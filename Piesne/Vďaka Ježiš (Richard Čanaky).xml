<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:47">
  <properties>
    <titles>
      <title>Vďaka Ježiš</title>
    </titles>
    <authors>
      <author>Richard Čanaky</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Vďaka Ježiš, vďaka za dnešný deň,<br/>vďaka Ježiš, s Tebou prežiť ho chcem,<br/>vďaka Ježiš, že mi lásku dávaš,<br/>volám Abba, Abba Otče, volám Abba, Abba Otče.</lines>
    </verse>
  </lyrics>
</song>
