<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:44">
  <properties>
    <titles>
      <title>Nesieme, Pane, chlieb a víno</title>
    </titles>
    <authors>
      <author>Obetné dary</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Nesieme, Pane, chlieb a víno,<br/>nesieme celý život náš,<br/>nesieme Pane chlieb a víno<br/>a hľadáme Tvoju tvár,<br/>Tvoju tvár, Tvoju svätú tvár.</lines>
    </verse>
  </lyrics>
</song>
