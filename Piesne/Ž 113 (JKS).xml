<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 113</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Chváľte Pána, lebo dvíha chudobných.</lines>
    </verse>
    <verse name="v2">
      <lines>Nech je velebené meno Pánovo odteraz až naveky.</lines>
    </verse>
    <verse name="v3">
      <lines>Pán mu dal sedieť vedľa kniežat svojho ľudu.</lines>
    </verse>
    <verse name="v4">
      <lines>Pán si ma vybral <br/>spomedzi chudobných.</lines>
    </verse>
    <verse name="v5">
      <lines>Pánova sláva prevyšuje nebesia.</lines>
    </verse>
    <verse name="v6">
      <lines>Pánovo meno chváľme, zvelebujme.</lines>
    </verse>
  </lyrics>
</song>
