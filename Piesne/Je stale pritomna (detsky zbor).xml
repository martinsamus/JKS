  <properties>
    <titles>
      <title>Je stale pritomna</title>
    </titles>
    <authors>
      <author>detsky zbor</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Je stále prítomná tvoja láska.<br/>Radostne spievame o tvojej sláve.<br/>[: Nech pieseň zazvoní v každej chvíli,<br/>teba chválim, Pane môj, ako najlepšie viem. :]</lines>
    </verse>
  </lyrics>
