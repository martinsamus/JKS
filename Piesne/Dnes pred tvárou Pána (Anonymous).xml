<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:42">
  <properties>
    <titles>
      <title>Dnes pred tvárou Pána</title>
    </titles>
    <authors>
      <author>Anonymous</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>1. /: Dnes pred tvárou Pána pokorme sa. :/</lines>
    </verse>
    <verse name="c1">
      <lines>R: Pán sám povýši nás, jeho je vesmír a čas,<br/>Pán sám povýši nás.<br/></lines>
    </verse>
    <verse name="v2">
      <lines>2. /: Všetky svoje bôle oddajme mu. :/<br/></lines>
    </verse>
    <verse name="v3">
      <lines>3. /: Oslavujme ho po všetky dni. :/<br/></lines>
    </verse>
    <verse name="v4">
      <lines>4. /: Zaspievajme Pánovi ešte raz. :/</lines>
    </verse>
  </lyrics>
</song>
