  <lyrics>
    <verse name="v1">
      <lines>Vo svojej veľkej láske <br/>vyslyš ma, Pane.</lines>
    </verse>
    <verse name="v2">
      <lines>Hľadajte, pokorní, Pána <br/>a srdce vám oživne.</lines>
    </verse>
    <verse name="v3">
      <lines>V tomto čase milosti <br/>vyslyš ma, Pane.</lines>
    </verse>
  </lyrics>
