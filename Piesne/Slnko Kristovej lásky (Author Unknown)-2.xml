<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:46">
  <properties>
    <titles>
      <title>Slnko Kristovej lásky</title>
    </titles>
    <authors>
      <author>Author Unknown</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Slnko Kristovej lásky nech ožiari nás.<br/>Oheň Svätého Ducha nech zapáli nás.<br/>Nech netlejeme len,<br/>nech nezhasína deň,<br/>deň, v ktorom sa Jeho meno oslavovať má.</lines>
    </verse>
  </lyrics>
</song>
