    <titles>
      <title>Nasytene dieta - Zalm 131</title>
    </titles>
    <verseOrder>c1 v1 c1 v2 c1</verseOrder>
    <authors>
      <author>MlaKa</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pane,<chord name="Hmi"/> moje srdce sa nevys<chord name="A"/>tatuje.<br/>Moje<chord name="G"/> oči nehľadia p<chord name="A"/>ovýšene.<br/><br/><chord name="Hmi"/> Neženiem sa za veľkými <chord name="A"/>vecami,<br/>ani<chord name="G"/> za divmi ned<chord name="Fis"/>osiahnute<chord name="Hmi"/>ľnými.<chord name="A"/><br/><chord name="Hmi"/> Ref:<chord name="A"/><chord name="G"/><chord name="Fis"/><chord name="Hmi"/><chord name="A"/></lines>
    </verse>
    <verse name="v2">
      <lines>Ale<chord name="Hmi"/> ja som svoju dušu<chord name="A"/> upokojil<br/>a<chord name="G"/> utíšil.<chord name="A"/><br/><br/><chord name="Hmi"/> Dúfaj, Izrael, v<chord name="A"/> Pána <chord name="G"/><br/>odteraz až <chord name="A"/>naveky.<br/><chord name="Hmi"/>Ref:<chord name="A"/><chord name="G"/><chord name="A"/></lines>
    </verse>
    <verse name="c1">
      <lines>/: Ako<chord name="D"/> nasýtené dieťa v<chord name="A"/> matkinom <chord name="Hmi"/>náruč<chord name="G"/>í.<br/>Ako<chord name="D"/> nasýtené dieťa <chord name="A"/>tak je moja duša<chord name="G"/> vo mne.:/</lines>
    </verse>
  </lyrics>
