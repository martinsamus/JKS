<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 81</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pane, daj, aby sme počúvali tvoj hlas.</lines>
    </verse>
    <verse name="v2">
      <lines>Pane, ty máš slová večného života.</lines>
    </verse>
    <verse name="v3">
      <lines>Plesajme Bohu, <br/>nášmu pomocníkovi.</lines>
    </verse>
    <verse name="v4">
      <lines>Plesajte Bohu, <br/>ktorý nám pomáha.</lines>
    </verse>
  </lyrics>
</song>
