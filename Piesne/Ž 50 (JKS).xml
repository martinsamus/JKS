<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 50</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Kto kráča bez úhony, tomu ukážem Božiu spásu.</lines>
    </verse>
    <verse name="v2">
      <lines>Obetuj Bohu obetu chvály.</lines>
    </verse>
    <verse name="v3">
      <lines>Prijmi od nás, Pane, obetu chvály.</lines>
    </verse>
    <verse name="v4">
      <lines>Spamätajte sa <br/>a nezabúdajte na Boha.</lines>
    </verse>
    <verse name="v5">
      <lines>Ukáž nám, Pane, cestu spásy.</lines>
    </verse>
  </lyrics>
</song>
