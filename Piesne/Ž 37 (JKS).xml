<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:48">
  <properties>
    <titles>
      <title>Ž 37</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pane, spas ma; <br/>ochraňuj ma v čase súženia.</lines>
    </verse>
    <verse name="v2">
      <lines>Pánovi zver svoje cesty, <br/>on sa už postará.</lines>
    </verse>
    <verse name="v3">
      <lines>Spása spravodlivých prichádza od Pána.</lines>
    </verse>
    <verse name="v4">
      <lines>Z úst spravodlivého <br/>zaznieva múdrosť.</lines>
    </verse>
  </lyrics>
</song>
