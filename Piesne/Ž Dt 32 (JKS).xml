  <lyrics>
    <verse name="v1">
      <lines>Opustil si Boha, <br/>svojho stvoriteľa.</lines>
    </verse>
    <verse name="v2">
      <lines>Pán je vodcom <br/>svojho verného ľudu.</lines>
    </verse>
    <verse name="v3">
      <lines>Pane, <br/>zľutuj sa  nad svojimi služobníkmi.</lines>
    </verse>
  </lyrics>
