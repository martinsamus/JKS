  <properties>
    <titles>
      <title>Ž 27</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Pán je moje svetlo <br/>a moja spása.</lines>
    </verse>
    <verse name="v2">
      <lines>Pane, moja pomoc, <br/>hľadám tvoju tvár.</lines>
    </verse>
    <verse name="v3">
      <lines>Verím, že uvidím dobrodenia Pánove <br/>v krajine žijúcich.</lines>
    </verse>
  </lyrics>
</song>
