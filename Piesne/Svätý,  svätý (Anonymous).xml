<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:46">
  <properties>
    <titles>
      <title>Svätý,  svätý</title>
    </titles>
    <authors>
      <author>Anonymous</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Svätý,  svätý,  svätý <br/>je Pán Boh všetkých svetov.</lines>
    </verse>
    <verse name="v2">
      <lines>Plné sú nebesia i zem Tvojej slávy.</lines>
    </verse>
    <verse name="c1">
      <lines>Hosanna na výsostiach!</lines>
    </verse>
    <verse name="v3">
      <lines>Požehnaný,  ktorý prichádza v mene Pánovom.</lines>
    </verse>
  </lyrics>
</song>
