  <lyrics>
    <verse name="v1">
      <lines>Vo svojej dobrote, Bože, pripravil si dom chudobnému.</lines>
    </verse>
    <verse name="v2">
      <lines>Náš Boh je Boh spásy, on je náš Pán.</lines>
    </verse>
    <verse name="v3">
      <lines>Spievajme nášmu Pánovi hlasom radostným.</lines>
    </verse>
  </lyrics>
