<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 117</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Budú sa ti klaňať, Pane, <br/>všetky národy zeme.</lines>
    </verse>
    <verse name="v2">
      <lines>Budete mi svedkami <br/>až po samý kraj zeme.</lines>
    </verse>
    <verse name="v3">
      <lines>Choďte do celého sveta <br/>a hlásajte evanjelium.</lines>
    </verse>
  </lyrics>
</song>
