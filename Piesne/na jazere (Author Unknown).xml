  <lyrics>
    <verse name="v1">
      <lines>Na jazere je veľká búrka,<br/>Ježiš so mnou v loďke je. 2x</lines>
    </verse>
    <verse name="c1">
      <lines>On za ruku drží ma,<br/>loďka sa nekolembá.<br/>Na jazere je veľká búrka,<br/>Ježiš so mnou v loďke je. 2x</lines>
    </verse>
