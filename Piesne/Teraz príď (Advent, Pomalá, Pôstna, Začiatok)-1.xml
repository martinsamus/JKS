  <properties>
    <titles>
      <title>Teraz príď</title>
    </titles>
    <authors>
      <author>Pomalá</author>
      <author>Advent</author>
      <author>Začiatok</author>
      <author>Pôstna</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Teraz príď, teraz príď,<br/>teraz príď, teraz príď,<br/>teraz príď, príď k nám,<br/>lebo viem, lebo viem,<br/>že máš s nami so všetkými<br/>nádherný plán.</lines>
    </verse>
  </lyrics>
</song>
