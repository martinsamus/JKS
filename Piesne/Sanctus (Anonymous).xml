  <lyrics>
    <verse name="v1">
      <lines>Sanctus, Sanctus, Sanctus, <br/>Dominus Deus Sabaoth.<br/>Pleni sunt caeli et terra gloria tua.<br/><p style="page-break-after: always;"/><br/>Hosanna in excelsis.<br/>Benedictus qui venit<br/>in nomine Domini.<br/>Hosanna in excelsis.</lines>
    </verse>
