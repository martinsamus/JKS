  <properties>
    <titles>
      <title>325. Požehnaj nás z vysokosti</title>
    </titles>
    <authors>
      <author>JKS1</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Požehnaj nás z vysokosti,<br/>Bože, v svojej láskavosti;<br/>Pane, Kriste, Spasiteľ náš,<br/>chráň od zlého, opatruj nás!</lines>
    </verse>
  </lyrics>
