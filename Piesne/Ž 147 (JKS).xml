      <title>Ž 147</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Slovo sa telom stalo a prebývalo medzi nami.</lines>
    </verse>
    <verse name="v2">
      <lines>Blahoslavení všetci, čo očakávajú Pána.</lines>
    </verse>
    <verse name="v3">
      <lines>Chváľ, Jeruzalem, Pána, oslavuj, Sion, svojho Boha.</lines>
    </verse>
    <verse name="v4">
      <lines>Chváľme Pána, on uzdravuje skľúčených srdcom.</lines>
    </verse>
  </lyrics>
</song>
