<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:49">
  <properties>
    <titles>
      <title>Ž 112</title>
    </titles>
    <authors>
      <author>JKS</author>
    </authors>
    <songbooks>
      <songbook name="Kurima Žalmy"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Spravodlivým žiari svetlo <br/>v temnotách.</lines>
    </verse>
    <verse name="v2">
      <lines>Blažený muž, <br/>ktorý sa bojí Pána</lines>
    </verse>
    <verse name="v3">
      <lines>Srdce spravodlivého je pevné, <br/>dôveruje v Pána.</lines>
    </verse>
    <verse name="v4">
      <lines>V obľube je človek, <br/>čo sa zľutúva a rád pomáha.</lines>
    </verse>
    <verse name="v5">
      <lines>Spravodlivý rozdeľuje a dáva.</lines>
    </verse>
  </lyrics>
</song>
