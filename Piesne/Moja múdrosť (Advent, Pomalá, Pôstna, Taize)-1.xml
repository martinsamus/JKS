<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.8" createdIn="OpenLP 3.1.7" modifiedIn="OpenLP 3.1.7" modifiedDate="2026-06-14T23:42:44">
  <properties>
    <titles>
      <title>Moja múdrosť</title>
    </titles>
    <authors>
      <author>Pôstna</author>
      <author>Advent</author>
      <author>Taize</author>
      <author>Pomalá</author>
    </authors>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Moja múdrosť a moja nádej,<br/>moja pieseň je Pán.<br/>On je Boh a Spasiteľ náš<br/>tak sa nebojte Ježiš je tu,<br/>nebojte sa,<br/>veď náš Pán je tu.</lines>
    </verse>
  </lyrics>
</song>
